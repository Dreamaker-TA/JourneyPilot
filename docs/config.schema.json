          "default": "1 day",
          "title": "Rotation",
          "type": "string"
        }
      },
      "title": "FileLogConfig",
      "type": "object"
    },
    "GeocodingConfig": {
      "additionalProperties": false,
      "description": "OSM 地点 provider（Nominatim / Overpass）访问配置。",
      "properties": {
        "min_interval_seconds": {
          "default": 1.1,
          "title": "Min Interval Seconds",
          "type": "number"
        },
        "nominatim_base_url": {
          "default": "https://nominatim.openstreetmap.org",
          "title": "Nominatim Base Url",
          "type": "string"
        },
        "search_cache_key_prefix": {
          "default": "journeypilot:nominatim-search:v1",
          "minLength": 1,
          "title": "Search Cache Key Prefix",
          "type": "string"
        },
        "search_cache_redis_timeout_seconds": {
          "default": 0.25,
          "exclusiveMinimum": 0,
          "title": "Search Cache Redis Timeout Seconds",
          "type": "number"
        },
        "search_cache_ttl_seconds": {
          "default": 604800,
          "exclusiveMinimum": 0,
          "title": "Search Cache Ttl Seconds",
          "type": "integer"
        },
        "search_timeout_seconds": {
          "default": 3.4,
          "exclusiveMinimum": 0,
          "title": "Search Timeout Seconds",
          "type": "number"
        },
        "timeout_seconds": {
          "default": 10.0,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "user_agent": {
          "default": "JourneyPilot/1.0 (travel itinerary geocoder; https://github.com/journeypilot)",
          "title": "User Agent",
          "type": "string"
        }
      },
      "title": "GeocodingConfig",
      "type": "object"
    },
    "IngestConfig": {
      "additionalProperties": false,
      "description": "上传与文档解析的硬输入边界。\n\n只限制原始字节不够：DOCX 是 ZIP，一份 200 KB 的上传展开后可以是几个 GB。\n每一项都必须在**读进内存之前或读进内存的过程中**可判，不能靠超时兜底 ——\n线程里的解析器杀不掉，超时只停止等待。",
      "properties": {
        "max_compression_ratio": {
          "default": 100.0,
          "exclusiveMinimum": 1,
          "title": "Max Compression Ratio",
          "type": "number"
        },
        "max_docx_entries": {
          "default": 5000,
          "minimum": 1,
          "title": "Max Docx Entries",
          "type": "integer"
        },
        "max_extracted_chars": {
          "default": 2000000,
          "minimum": 1024,
          "title": "Max Extracted Chars",
          "type": "integer"
        },
        "max_pdf_pages": {
          "default": 500,
          "minimum": 1,
          "title": "Max Pdf Pages",
          "type": "integer"
        },
        "max_uncompressed_bytes": {
          "default": 104857600,
          "minimum": 1024,
          "title": "Max Uncompressed Bytes",
          "type": "integer"
        },
        "max_upload_bytes": {
          "default": 10485760,
          "minimum": 1024,
          "title": "Max Upload Bytes",
          "type": "integer"
        },
        "parse_address_space_bytes": {
          "default": 2147483648,
          "minimum": 0,
          "title": "Parse Address Space Bytes",
          "type": "integer"
        },
        "parse_cpu_seconds": {
          "default": 60,
          "minimum": 0,
          "title": "Parse Cpu Seconds",
          "type": "integer"
        },
        "parse_timeout_seconds": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "title": "Parse Timeout Seconds",
          "type": "number"
        }
      },
      "title": "IngestConfig",
      "type": "object"
    },
    "LoggingConfig": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "$ref": "#/$defs/FileLogConfig"
