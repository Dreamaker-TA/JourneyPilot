    "ProviderChannelConfig": {
      "additionalProperties": false,
      "description": "按上游通道分配的同时在飞条数。**连接池容量不是产品预算。**\n\n底层 httpx 连接池上限 1000 不代表允许一次入库发 1000 条模型调用。速率闸\n（`utils/rate_gate.py`）管两次请求之间的间隔，这里管同时在飞的条数，两件事。",
      "properties": {
        "embedding": {
          "default": 4,
          "minimum": 1,
          "title": "Embedding",
          "type": "integer"
        },
        "ingest_contextual_llm": {
          "default": 4,
          "minimum": 1,
