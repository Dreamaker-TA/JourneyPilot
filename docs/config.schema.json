    "MaintenanceConfig": {
      "additionalProperties": false,
      "description": "备份 / 迁移 / 恢复这类维护动作的配置。\n\n只被 `journeypilot` CLI 与启动编排器读取，API 进程不用它 —— 那条边界是\nADR-P0-03（API 进程不改 Schema、不改物理数据库）。",
      "properties": {
        "backup_dir": {
          "default": "backups",
          "title": "Backup Dir",
          "type": "string"
        },
        "keep_automatic_backups": {
          "default": 5,
          "minimum": 1,
          "title": "Keep Automatic Backups",
          "type": "integer"
        },
        "migration_lock_timeout_seconds": {
          "default": 30.0,
          "exclusiveMinimum": 0,
          "title": "Migration Lock Timeout Seconds",
          "type": "number"
        },
        "postgres_container": {
          "default": "",
          "title": "Postgres Container",
          "type": "string"
        }
      },
      "title": "MaintenanceConfig",
      "type": "object"
    },
    "ModelPricingItem": {
      "additionalProperties": false,
      "description": "单条模型定价（USD / 1M tokens，读折扣型缓存计费）。\n\n台账层按 (model_request, provider) 前缀匹配到一条价格，写入时快照计算\ncost_usd。价格随时变动——`effective_from` 记录抓取日期，`source_url` 记录来源，用户\n可在 config.yaml 覆盖或追加档位。",
      "properties": {
        "cache_write_per_1m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Write Per 1M"
        },
        "cached_input_per_1m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cached Input Per 1M"
        },
        "currency": {
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "effective_from": {
          "default": "",
          "title": "Effective From",
          "type": "string"
        },
        "input_per_1m": {
          "default": 0.0,
          "title": "Input Per 1M",
          "type": "number"
        },
        "output_per_1m": {
          "default": 0.0,
          "title": "Output Per 1M",
          "type": "number"
        },
        "pattern": {
          "title": "Pattern",
          "type": "string"
        },
        "provider": {
          "default": "",
          "title": "Provider",
          "type": "string"
        },
        "source_url": {
          "default": "",
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "pattern"
      ],
      "title": "ModelPricingItem",
      "type": "object"
    },
