{
  "$defs": {
    "BackgroundJobsConfig": {
      "additionalProperties": false,
      "description": "durable 后台任务 worker 的边界。",
      "properties": {
        "batch_size": {
          "default": 1,
          "minimum": 1,
          "title": "Batch Size",
          "type": "integer"
        },
        "completed_retention_days": {
          "default": 30,
          "minimum": 1,
          "title": "Completed Retention Days",
          "type": "integer"
        },
        "lease_seconds": {
          "default": 60,
          "exclusiveMinimum": 0,
          "title": "Lease Seconds",
          "type": "integer"
        },
        "poll_seconds": {
          "default": 5.0,
          "exclusiveMinimum": 0,
          "title": "Poll Seconds",
          "type": "number"
        }
      },
      "title": "BackgroundJobsConfig",
      "type": "object"
    },
    "BlockingWorkConfig": {
      "additionalProperties": false,
      "description": "同步工作被赶出 Event Loop 之后的并发与排队上界。**全仓唯一定义处**。\n\n线程池不是无限资源：`services/blocking_work.py` 按通道分配，一个通道排满时\n调用方等 ``queue_wait_seconds``，不是无限排队。",
      "properties": {
        "cpu_projection": {
          "default": 2,
          "minimum": 1,
          "title": "Cpu Projection",
          "type": "integer"
        },
        "document_parse": {
          "default": 2,
          "minimum": 1,
          "title": "Document Parse",
          "type": "integer"
        },
        "local_embedding": {
          "default": 2,
          "minimum": 1,
          "title": "Local Embedding",
          "type": "integer"
        },
        "pdf_export": {
          "default": 1,
          "minimum": 1,
          "title": "Pdf Export",
          "type": "integer"
        },
        "queue_wait_seconds": {
          "default": 30.0,
          "exclusiveMinimum": 0,
          "title": "Queue Wait Seconds",
          "type": "number"
        }
      },
      "title": "BlockingWorkConfig",
      "type": "object"
    },
    "CheckpointRetentionConfig": {
      "additionalProperties": false,
      "description": "LangGraph checkpoint retention policy.",
      "properties": {
        "batch_size": {
          "default": 100,
          "title": "Batch Size",
          "type": "integer"
        },
        "cancelled_days": {
          "default": 30,
          "title": "Cancelled Days",
          "type": "integer"
        },
        "completed_days": {
          "default": 30,
          "title": "Completed Days",
          "type": "integer"
        },
        "failed_interrupted_days": {
          "default": 90,
          "title": "Failed Interrupted Days",
          "type": "integer"
        },
        "require_on_startup": {
          "default": false,
          "title": "Require On Startup",
          "type": "boolean"
        }
      },
      "title": "CheckpointRetentionConfig",
      "type": "object"
    },
    "DataSnapshotsConfig": {
      "additionalProperties": false,
      "description": "Governance thresholds for upstream data committed into the repo.\n\n``station_max_age_days``: 90 days is a threshold, not a fact — 12306 publishes\nno version token, so age is the only proxy available and the number expresses\nhow long the repo is willing to answer station questions from a table nobody\nhas re-checked.  A configuration item rather than a constant because the\ntolerable staleness is an operating decision (a demo week and a quiet month are\nnot the same), and because a hardcoded 90 is one more hand-maintained number\nwith no way to change it in the field.",
      "properties": {
        "station_max_age_days": {
          "default": 90,
          "exclusiveMinimum": 0,
          "title": "Station Max Age Days",
          "type": "integer"
        }
      },
      "title": "DataSnapshotsConfig",
      "type": "object"
    },
    "DatabaseConfig": {
      "additionalProperties": false,
      "description": "PostgreSQL + pgvector 数据库配置",
      "properties": {
        "host": {
          "default": "localhost",
          "title": "Host",
          "type": "string"
        },
        "max_overflow": {
          "default": 20,
          "title": "Max Overflow",
          "type": "integer"
        },
        "name": {
          "default": "travel_agent",
          "title": "Name",
          "type": "string"
        },
        "password": {
          "default": "travel_agent_pwd",
          "title": "Password",
          "type": "string"
        },
        "pool_size": {
          "default": 10,
          "title": "Pool Size",
          "type": "integer"
        },
        "port": {
          "default": 5432,
          "title": "Port",
          "type": "integer"
        },
        "user": {
          "default": "travel_agent",
          "title": "User",
          "type": "string"
        }
      },
      "title": "DatabaseConfig",
      "type": "object"
    },
    "EmbeddingConfig": {
      "additionalProperties": false,
      "description": "Embedding 模型配置（用于 RAG 向量化）\n\nprovider = \"qwen3\"  → 本地 Qwen3-Embedding-0.6B ONNX 推理（默认，首次启动从 HF 下载 ~1.2GB）\nprovider = \"openai\" → OpenAI 兼容 Embedding API（需 api_key + base_url）\nprovider = \"hash\"   → 内置确定性哈希向量（零依赖，仅供 RAG 链路跑通，语义质量低）",
      "properties": {
        "api_key": {
          "default": "",
          "title": "Api Key",
          "type": "string"
        },
        "base_url": {
          "default": "https://api.openai.com/v1",
          "title": "Base Url",
          "type": "string"
        },
        "dimensions": {
          "default": 1024,
          "title": "Dimensions",
          "type": "integer"
        },
        "model_name": {
          "default": "n24q02m/Qwen3-Embedding-0.6B-ONNX",
          "title": "Model Name",
          "type": "string"
        },
        "provider": {
          "default": "qwen3",
          "title": "Provider",
          "type": "string"
        }
      },
      "title": "EmbeddingConfig",
      "type": "object"
    },
    "FastModelConfig": {
      "additionalProperties": false,
      "description": "轻量 LLM 配置（用于简单问答、路由判断等低延迟任务）\n\n方案A（默认）: MiniMax-M2.7 @ api.minimaxi.com/v1\n方案B（可选）: 本地 Qwen，model_name=\"qwen3.5:4b\", base_url=\"http://localhost:11434/v1\"",
      "properties": {
        "api_key": {
          "default": "",
          "title": "Api Key",
          "type": "string"
        },
        "base_url": {
          "default": "https://api.minimaxi.com/v1",
          "title": "Base Url",
          "type": "string"
        },
        "max_tokens": {
          "default": 32768,
          "title": "Max Tokens",
          "type": "integer"
        },
        "model_name": {
          "default": "MiniMax-M2.7",
          "title": "Model Name",
          "type": "string"
        },
        "temperature": {
          "default": 0.5,
          "title": "Temperature",
          "type": "number"
        },
        "timeout": {
          "default": 30,
          "title": "Timeout",
          "type": "integer"
        }
      },
      "title": "FastModelConfig",
      "type": "object"
    },
    "FileLogConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "path": {
          "default": "logs/",
          "title": "Path",
          "type": "string"
        },
        "retention": {
          "default": "7 days",
          "title": "Retention",
