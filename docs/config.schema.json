    "RoutingConfig": {
      "additionalProperties": false,
      "description": "Street/public-transit routing provider configuration.\n\nTwo upstreams behind one tool, split by geography rather than by preference:\namap answers inside the China coordinate box, Transitous/MOTIS answers the\nrest of the world. That is not a taste —     MOTIS carries no mainland-China\ntransit feed at all (measured: zero routes visited for a 7.9 km\nShenzhen hop), and amap covers nowhere else.",
      "properties": {
        "amap_base_url": {
          "default": "https://restapi.amap.com",
          "title": "Amap Base Url",
          "type": "string"
        },
        "min_interval_seconds": {
          "default": 1.0,
          "title": "Min Interval Seconds",
          "type": "number"
        },
        "timeout_seconds": {
          "default": 20.0,
